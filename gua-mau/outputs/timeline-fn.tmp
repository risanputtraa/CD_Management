function projectTimeline(projectId){
 const project=state.projects.find(x=>x.project_id===projectId),plan=groupedPlan(projectId).filter(x=>Number(x.is_selected)!==0&&Number(x.planned_quantity)>0),byType=new Map();
 for(const line of plan){if(!byType.has(line.task_type_id))byType.set(line.task_type_id,{task_type_id:line.task_type_id,task_type_name:line.task_type_name,department_id:line.department_id||state.taskTypes.find(t=>t.task_type_id===line.task_type_id)?.department_id||'',department_name:line.department_name||'No department',work:0,missing:0});const node=byType.get(line.task_type_id),cap=Number(line.tasks_per_person_per_day||state.taskTypes.find(t=>t.task_type_id===line.task_type_id)?.capacities.find(c=>Number(c.difficulty_level)===Number(line.difficulty_level))?.tasks_per_person_per_day)||0;if(cap>0)node.work+=Number(line.planned_quantity)/cap;else node.missing+=Number(line.planned_quantity)}
 const nodes=[...byType.values()],deps=state.timelineDependencies.filter(x=>x.project_id===projectId&&byType.has(x.task_type_id)&&byType.has(x.predecessor_task_type_id)),predecessors=new Map(nodes.map(n=>[n.task_type_id,new Set(deps.filter(x=>x.task_type_id===n.task_type_id).map(x=>x.predecessor_task_type_id))]));
 const remain=new Map(nodes.map(n=>[n.task_type_id,n.missing?Infinity:n.work])),dates=new Map(nodes.map(n=>[n.task_type_id,{start:'',end:''}])),daily=new Map();let date=project?.start_date||new Date().toISOString().slice(0,10);
 for(let day=0;day<4000;day++){let moved=false;if(isProjectWorkday(date)){const departments=new Set(nodes.filter(n=>remain.get(n.task_type_id)>0.000001&&!n.missing).map(n=>n.department_id));for(const dept of departments){const people=nodes.find(n=>n.department_id===dept)?projectStaffCount(projectId,dept):0;if(!people)continue;const ready=nodes.filter(n=>n.department_id===dept&&remain.get(n.task_type_id)>0.000001&&!n.missing&&[...(predecessors.get(n.task_type_id)||[])].every(id=>(remain.get(id)||0)<=0.000001));if(!ready.length)continue;const each=people/ready.length;for(const node of ready){const amount=Math.min(remain.get(node.task_type_id),each);if(amount<=0)continue;moved=true;if(!dates.get(node.task_type_id).start)dates.get(node.task_type_id).start=date;dates.get(node.task_type_id).end=date;remain.set(node.task_type_id,remain.get(node.task_type_id)-amount);daily.set(date,(daily.get(date)||0)+amount)}}}if([...remain.values()].every(x=>x<=0.000001))break;if(!moved)break;date=addCalendarDays(date,1)}
 const total=nodes.reduce((sum,n)=>sum+n.work,0),datesOut=[...daily.keys()].sort();
 const actualByDate=new Map(),taskRows=state.tasks.filter(t=>t.project_id===projectId&&t.plan_line_id);for(const t of taskRows){if(t.status!=='Done'||!t.completed_at||!t.task_type_id)continue;const typ=state.taskTypes.find(x=>x.task_type_id===t.task_type_id),cap=typ?.capacities.find(c=>Number(c.difficulty_level)===Number(t.difficulty_level)),rate=Number(cap?.tasks_per_person_per_day)||0,work=rate>0?1/rate:(Number(t.current_weight)||0)/7;if(work<=0)continue;const day=String(t.completed_at).slice(0,10);actualByDate.set(day,(actualByDate.get(day)||0)+work)}
 const plannedEnd=datesOut.at(-1)||project?.start_date||'',today=new Date().toISOString().slice(0,10),end=[plannedEnd,today,project?.deadline||''].filter(Boolean).sort().at(-1)||today,completedTasks=taskRows.filter(t=>t.status==='Done').length;
 return{project,nodes,deps,predecessors,dates,daily,remain,total,plannedEnd,end,actualByDate,completedTasks,taskCount:taskRows.length};
}
